# Copy this file to .env. Never commit the real .env file.

# SNO / WordPress site root (no trailing slash).
SNO_SITE=https://example-school-news-site.org

# Keep both true until the browser selectors and saved login session are verified.
DRY_RUN_ARTICLES=true
DRY_RUN_STAFF=true

# Staff-year taxonomy label on the target SNO site.
STAFF_YEAR=2026-2027

# Optional local settings.
PLAYWRIGHT_PROFILE_DIR=playwright_sno_profile
FLASK_SECRET_KEY=replace-with-a-random-local-secret
FLASK_DEBUG=false
PORT=5000

# The committed demo schedule uses August 8, 2026.
# Leave blank to use the real current date.
TODAY_OVERRIDE=2026-08-08
